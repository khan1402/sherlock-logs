{
  "uid": "vm-performance",
  "title": "VM Performance",
  "description": "Host metrics from Node Exporter on every VM: CPU, memory, disk, disk I/O, network.",
  "tags": ["sherlock-logs", "vm", "node-exporter"],
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "VM",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": {"query": "label_values(up{job=\"node\"}, instance)", "refId": "V"},
        "definition": "label_values(up{job=\"node\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {"selected": true, "text": ["All"], "value": ["$__all"]},
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1},
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "VMs up",
      "description": "Node Exporter targets answering right now (out of all VMs in the inventory).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 1, "w": 6, "h": 4},
      "fieldConfig": {
        "defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}},
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "targets": [{"refId": "A", "expr": "sum(up{job=\"node\"})", "legendFormat": "", "instant": true}],
      "id": 2
    },
    {
      "type": "stat",
      "title": "VMs down",
      "description": "VMs Prometheus cannot reach. Anything above 0 is an outage.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 6, "y": 1, "w": 6, "h": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=\"node\"} == 0) or vector(0)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Average CPU",
      "description": "",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 1, "w": 6, "h": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 70},
              {"color": "red", "value": 80}
            ]
          }
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$instance\"}[5m])))",
          "legendFormat": "",
          "instant": true
        }
      ],
      "id": 4
    },
    {
      "type": "stat",
      "title": "Average memory used",
      "description": "",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 18, "y": 1, "w": 6, "h": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 80},
              {"color": "red", "value": 90}
            ]
          }
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - sum(node_memory_MemAvailable_bytes{instance=~\"$instance\"}) / sum(node_memory_MemTotal_bytes{instance=~\"$instance\"}))",
          "legendFormat": "",
          "instant": true
        }
      ],
      "id": 5
    },
    {
      "type": "row",
      "title": "CPU and memory",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 5, "w": 24, "h": 1},
      "panels": [],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "CPU usage per VM",
      "description": "Share of CPU time not idle. Alert: above 80% for 5 minutes.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {"unit": "percent", "custom": {"fillOpacity": 10, "showPoints": "never"}, "min": 0, "max": 100},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{instance}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Memory usage per VM",
      "description": "RAM in use (excluding cache that can be freed). Alert: above 90% for 5 minutes.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {"unit": "percent", "custom": {"fillOpacity": 10, "showPoints": "never"}, "min": 0, "max": 100},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{instance=~\"$instance\"} / node_memory_MemTotal_bytes{instance=~\"$instance\"})",
          "legendFormat": "{{instance}}"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Load average (1 min)",
      "description": "Processes waiting for CPU. Above the number of cores = the VM is overloaded.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"fillOpacity": 10, "showPoints": "never"}}, "overrides": []},
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [{"refId": "A", "expr": "node_load1{instance=~\"$instance\"}", "legendFormat": "{{instance}}"}],
      "id": 9
    },
    {
      "type": "bargauge",
      "title": "Disk space used (/)",
      "description": "Root filesystem usage. Alert: less than 20% free (above 80% used).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 70},
              {"color": "red", "value": 85}
            ]
          }
        },
        "overrides": []
      },
      "options": {"orientation": "horizontal", "displayMode": "gradient", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\",instance=~\"$instance\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\",instance=~\"$instance\"})",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "id": 10
    },
    {
      "type": "row",
      "title": "Disk I/O and network",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 22, "w": 24, "h": 1},
      "panels": [],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Disk read",
      "description": "Bytes read from disk per second.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 23, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"fillOpacity": 10, "showPoints": "never"}}, "overrides": []},
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(node_disk_read_bytes_total{device!~\"loop.*|sr.*\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Disk write",
      "description": "Bytes written to disk per second.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 23, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"fillOpacity": 10, "showPoints": "never"}}, "overrides": []},
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(node_disk_written_bytes_total{device!~\"loop.*|sr.*\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Network received",
      "description": "Incoming traffic on the VM's real network interfaces.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 31, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"fillOpacity": 10, "showPoints": "never"}}, "overrides": []},
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{device!~\"lo|docker.*|veth.*|br-.*\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "Network sent",
      "description": "Outgoing traffic on the VM's real network interfaces.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 31, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"fillOpacity": 10, "showPoints": "never"}}, "overrides": []},
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(node_network_transmit_bytes_total{device!~\"lo|docker.*|veth.*|br-.*\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "id": 15
    }
  ],
  "annotations": {"list": []}
}
