# {{ ansible_managed }}
# The monitoring stack on {{ inventory_hostname }}.
#
#   Metrics (Group 4): Prometheus (collects + stores), Grafana (shows)
#   Logs    (Group 5): Elasticsearch x2 (stores), Logstash (receives + parses), Kibana (shows)
#   Alerts  (Group 7): Elasticsearch exporter (cluster health for Prometheus/Grafana)
#
# network_mode: host on every service the network may reach (Prometheus,
# Grafana, Logstash, Kibana): the containers use the VM's own ports, so UFW
# decides who may connect. Published ports (-p) would make Docker write its
# own iptables rules and BYPASS UFW (Project 3 lesson).
#
# Config FOLDERS are mounted, not single files: Ansible replaces a file by
# writing a new one, and a single-file mount would keep showing the OLD file
# to the container, so a reload would read stale config.
#
# Data lives in named Docker volumes: it survives container upgrades and
# restarts, and Docker sets the right file owner automatically.

name: monitoring

services:
  # --- Metrics ------------------------------------------------------------------------
  prometheus:
    image: {{ monitoring_prometheus_image }}
    container_name: prometheus
    restart: unless-stopped
    network_mode: host
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      # Long-term retention: whichever limit is reached first.
      - --storage.tsdb.retention.time={{ monitoring_retention_time }}
      - --storage.tsdb.retention.size={{ monitoring_retention_size }}
      - --web.listen-address=:{{ monitoring_prometheus_port }}
      # Allows "reload config" via HTTP (POST /-/reload) - no restart, no data gap.
      - --web.enable-lifecycle
    volumes:
      - ./prometheus:/etc/prometheus:ro
      - prometheus-data:/prometheus

  grafana:
    image: {{ monitoring_grafana_image }}
    container_name: grafana
    restart: unless-stopped
    network_mode: host
    depends_on:
      - prometheus
    environment:
      GF_SERVER_HTTP_PORT: "{{ monitoring_grafana_port }}"
      # Admin login. NOTE: only applied when Grafana starts for the FIRST time
      # (empty database). To change it later: grafana cli admin reset-admin-password.
      GF_SECURITY_ADMIN_USER: "{{ monitoring_grafana_admin_user }}"
      # replace + to_json: '$' is doubled (Compose would read it as a variable)
      # and the value is safely quoted, whatever characters the password has.
      GF_SECURITY_ADMIN_PASSWORD: {{ monitoring_grafana_admin_password | replace('$', '$$') | to_json }}
      GF_USERS_ALLOW_SIGN_UP: "false"          # nobody can create their own account
      GF_AUTH_ANONYMOUS_ENABLED: "false"       # no viewing without login
      GF_ANALYTICS_REPORTING_ENABLED: "false"  # no usage data sent to Grafana Labs
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      # No automatic download of extra plugins at start (saves RAM and time; not used).
      GF_PLUGINS_PREINSTALL_DISABLED: "true"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/etc/grafana/dashboards:ro  # dashboard JSON files
      - grafana-data:/var/lib/grafana

  # --- Logs ---------------------------------------------------------------------------
  # Two-node Elasticsearch cluster on a private Docker network ("elastic").
  #   es01 = master + data: manages the cluster and stores data
  #   es02 = data only:     stores the replica copy of every index
  # Every index has 1 replica, kept on the OTHER node. Stop es02 and the
  # replicas are missing -> cluster turns YELLOW (data still complete on es01).
  # es02 is deliberately NOT master-eligible: with 2 master-eligible nodes,
  # losing one would leave no majority and the whole cluster would stop.
  es01:
    image: {{ monitoring_elasticsearch_image }}
    container_name: es01
    restart: unless-stopped
    environment:
      node.name: es01
      node.roles: master,data,ingest
      cluster.name: sherlock-logs
      cluster.initial_master_nodes: es01  # who may form the cluster on first start
      discovery.seed_hosts: es01,es02
      # Security (passwords + TLS) is off: Elasticsearch is reachable ONLY on
      # this VM's loopback and the private Docker network, never from outside.
      xpack.security.enabled: "false"
      ES_JAVA_OPTS: "-Xms{{ monitoring_es_heap }} -Xmx{{ monitoring_es_heap }}"
    mem_limit: {{ monitoring_es_mem_limit }}
    networks: [elastic]
    ports:
      - "127.0.0.1:{{ monitoring_es01_port }}:9200"  # loopback only: invisible to the network
    volumes:
      - es01-data:/usr/share/elasticsearch/data

  es02:
    image: {{ monitoring_elasticsearch_image }}
    container_name: es02
    restart: unless-stopped
    environment:
      node.name: es02
      node.roles: data,ingest
      cluster.name: sherlock-logs
      discovery.seed_hosts: es01,es02
      xpack.security.enabled: "false"
      ES_JAVA_OPTS: "-Xms{{ monitoring_es_heap }} -Xmx{{ monitoring_es_heap }}"
    mem_limit: {{ monitoring_es_mem_limit }}
    networks: [elastic]
    ports:
      - "127.0.0.1:{{ monitoring_es02_port }}:9200"
    volumes:
      - es02-data:/usr/share/elasticsearch/data

  logstash:
    image: {{ monitoring_logstash_image }}
    container_name: logstash
    restart: unless-stopped
    network_mode: host  # Filebeat connects to port {{ monitoring_logstash_beats_port }} on this VM
    depends_on:
      - es01
    environment:
      LS_JAVA_OPTS: "-Xms{{ monitoring_logstash_heap }} -Xmx{{ monitoring_logstash_heap }}"
      CONFIG_RELOAD_AUTOMATIC: "true"  # pipeline changes apply without a restart
      XPACK_MONITORING_ENABLED: "false"
      # Log-pattern alerts are posted to this Slack webhook. Kept out of the
      # pipeline file: the pipeline reads it from this environment variable.
      SLACK_WEBHOOK_URL: {{ monitoring_slack_webhook_url | replace('$', '$$') | to_json }}
    mem_limit: {{ monitoring_logstash_mem_limit }}
    volumes:
      - ./logstash/pipeline:/usr/share/logstash/pipeline:ro

  kibana:
    image: {{ monitoring_kibana_image }}
    container_name: kibana
    restart: unless-stopped
    network_mode: host
    depends_on:
      - es01
    environment:
      SERVER_HOST: "0.0.0.0"
      SERVER_PORT: "{{ monitoring_kibana_port }}"
      SERVER_NAME: kibana
      # Both nodes listed: Kibana keeps working when one of them is down.
      ELASTICSEARCH_HOSTS: '["http://localhost:{{ monitoring_es01_port }}","http://localhost:{{ monitoring_es02_port }}"]'
      TELEMETRY_OPTIN: "false"
      NODE_OPTIONS: "--max-old-space-size={{ monitoring_kibana_node_heap_mb }}"
    mem_limit: {{ monitoring_kibana_mem_limit }}

  # Reads the cluster health from es01 and offers it as Prometheus metrics
  # (elasticsearch_cluster_health_status{color="green|yellow|red"}).
  elasticsearch-exporter:
    image: {{ monitoring_es_exporter_image }}
    container_name: elasticsearch-exporter
    restart: unless-stopped
    network_mode: host
    depends_on:
      - es01
    command:
      - --es.uri=http://localhost:{{ monitoring_es01_port }}
      - --web.listen-address=127.0.0.1:{{ monitoring_es_exporter_port }}  # loopback only

networks:
  elastic: {}

volumes:
  prometheus-data:
  grafana-data:
  es01-data:
  es02-data:
