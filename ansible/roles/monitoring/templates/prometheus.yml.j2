# {{ ansible_managed }}
# Prometheus configuration - WHAT to scrape and HOW often.
#
# Every target below is generated from the Ansible inventory: add a VM to
# inventory/hosts.yml, re-run Ansible, and Prometheus monitors it.
#
# Each target gets readable labels:
#   instance = VM name (e.g. web-server-1) instead of "192.168.56.11:9100"
#   group    = inventory group (e.g. webservers)
# Dashboards and alerts use them ("CPU high on web-server-1").
{% set node_hosts = groups['core'] + (groups['backups'] if enable_bonus | bool else []) %}

global:
  scrape_interval: {{ monitoring_scrape_interval }}
  evaluation_interval: {{ monitoring_evaluation_interval }}
  scrape_timeout: 10s

scrape_configs:
  # Prometheus watches itself (is it healthy, how much data does it store?).
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:{{ monitoring_prometheus_port }}"]
        labels:
          instance: {{ inventory_hostname }}

  # Host metrics from Node Exporter - every VM.
  - job_name: node
    static_configs:
{% for host in node_hosts %}
      - targets: ["{{ hostvars[host]['ansible_host'] }}:{{ hostvars[host]['node_exporter_port'] | default(9100) }}"]
        labels:
          instance: {{ host }}
          group: {{ hostvars[host]['group_names'] | reject('in', ['core', 'docker_hosts']) | first | default('ungrouped') }}
{% endfor %}

  # Container metrics from cAdvisor - every Docker VM.
  - job_name: cadvisor
    static_configs:
{% for host in groups['docker_hosts'] %}
      - targets: ["{{ hostvars[host]['ansible_host'] }}:{{ hostvars[host]['cadvisor_port'] | default(8081) }}"]
        labels:
          instance: {{ host }}
          group: {{ hostvars[host]['group_names'] | reject('in', ['core', 'docker_hosts']) | first | default('ungrouped') }}
{% endfor %}

  # Application metrics - backend API (/metrics on the app server).
  - job_name: backend
    metrics_path: /metrics
    static_configs:
{% for host in groups['appservers'] %}
      - targets: ["{{ hostvars[host]['ansible_host'] }}:3000"]
        labels:
          instance: {{ host }}
          service: backend
{% endfor %}

  # Application metrics - frontend (/metrics on each web server).
  - job_name: frontend
    metrics_path: /metrics
    static_configs:
{% for host in groups['webservers'] %}
      - targets: ["{{ hostvars[host]['ansible_host'] }}:80"]
        labels:
          instance: {{ host }}
          service: frontend
{% endfor %}
